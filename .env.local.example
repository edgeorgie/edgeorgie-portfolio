# All variables are optional. Copy to .env.local or set them as Vercel project env vars.

# Canonical site origin used for metadata, Open Graph, robots and sitemap.
# Defaults to https://www.itsedgeorgie.dev
# NEXT_PUBLIC_SITE_URL=https://www.itsedgeorgie.dev

# WhatsApp contact button. Overrides the number in src/lib/site.ts; "+", spaces and dashes are stripped.
# NEXT_PUBLIC_WHATSAPP_NUMBER=+573002813676

# PostHog (https://posthog.com) product analytics. When unset the SDK is never downloaded.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only. Raises the GitHub API rate limit for the per-project "last push" line.
# GITHUB_TOKEN=ghp_...
