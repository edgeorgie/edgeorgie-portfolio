# All variables are optional. Copy to .env.local or set them as Vercel project env vars.

# Canonical site origin used for metadata, Open Graph, robots and sitemap.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then https://edgeorgie-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=https://edgeorgie-portfolio.vercel.app

# WhatsApp contact button. E.164 digits only (country code + number), no "+", spaces or dashes,
# exactly the format wa.me expects. Leave unset to hide the button.
# NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567

# PostHog (https://posthog.com) product analytics. When unset the SDK is never downloaded.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only. Raises the GitHub API rate limit for the per-project "last push" line.
# GITHUB_TOKEN=ghp_...
